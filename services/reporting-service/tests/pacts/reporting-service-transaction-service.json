{
  "consumer": {
    "name": "reporting-service"
  },
  "interactions": [
    {
      "description": "a request to list transactions for a date range",
      "pending": false,
      "request": {
        "matchingRules": {
          "query": {
            "since": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "until": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/v1/transactions",
        "query": {
          "since": [
            "2026-01-01"
          ],
          "until": [
            "2026-01-02"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "items": [
              {
                "amount": 1250000,
                "createdAt": "2026-01-01T09:12:00Z",
                "currency": "USD",
                "customerId": "c-1001",
                "merchant": "WIRE_OUT_INTL",
                "status": "SETTLED",
                "txnId": "txn-001"
              }
            ],
            "total": 1
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.items[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].merchant": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^(PENDING|SETTLED|DECLINED|REVERSED)$"
                }
              ]
            },
            "$.items[*].txnId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "transaction-service"
  }
}