PORT=8000
LOG_LEVEL=info

# upstream services
AUTH_SERVICE_URL=http://localhost:8082
ACCOUNT_SERVICE_URL=http://localhost:8083
TXN_SERVICE_URL=http://localhost:8081
CUSTOMER_SERVICE_URL=http://localhost:8086
STATEMENT_SERVICE_URL=http://localhost:8087
AUDIT_SERVICE_URL=http://localhost:8088

# JWT (decode-only; signing handled by auth-service)
JWT_PUBLIC_KEY=

# rate limit (per IP)
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SEC=2
